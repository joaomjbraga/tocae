// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "io.github.joaomjbraga.tocae",
  // O projeto não usa auto-update: sem isso o electron-builder inferiria um
  // provedor GitHub a partir do repositório e incluiria app-update.yml no pacote.
  "publish": null,
  "asar": true,
  "asarUnpack": [
    "**/node_modules/exiftool-vendored.{pl,exe}/**",
    "**/node_modules/ffmpeg-static/ffmpeg",
    "**/node_modules/ffmpeg-static/ffmpeg.exe",
    "**/node_modules/@derhuerst/ffprobe-static/ffprobe",
    "**/node_modules/@derhuerst/ffprobe-static/ffprobe.exe"
  ],
  "productName": "Tocaê",
  "directories": {
    "output": "release/${version}",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!**/*.map",
    "!**/*.d.ts",
    "!**/*.ts",
    "!**/.DS_Store",
    "!**/.env",
    "!**/.env.*",
    "!**/.git",
    "!**/.git/**"
  ],
  "extraResources": [
    {
      "from": "licenses/GPL-3.0.txt",
      "to": "licenses/GPL-3.0.txt"
    }
  ],
  "linux": {
    "target": ["deb", "rpm"],
    "icon": "public/tocae.png",
    "category": "AudioVideo;Player;",
    "executableName": "tocae",
    "mimeTypes": [
      "video/mp4",
      "video/x-m4v",
      "video/webm",
      "video/x-matroska",
      "video/x-msvideo",
      "video/quicktime",
      "video/ogg",
      "video/mpeg",
      "audio/mpeg",
      "audio/mp4",
      "audio/aac",
      "audio/wav",
      "audio/flac",
      "audio/ogg",
      "audio/webm",
      "image/jpeg",
      "image/png",
      "image/apng",
      "image/webp",
      "image/gif",
      "image/bmp",
      "image/avif"
    ],
    // O nome do .desktop instalado precisa ser o mesmo que o app registra em
    // app.setDesktopName() para o ambiente associar a janela ao lançador.
    "syncDesktopName": true,
    "maintainer": "João M J Braga <joaomarcos.jbraga@gmail.com>",
    "vendor": "João M J Braga",
    "synopsis": "Reprodutor multimídia minimalista",
    "description": "Reprodutor multimídia minimalista, com suporte a vídeo, áudio e imagens, que permite criar playlists e reproduzir arquivos locais.",
    "desktop": {
      "entry": {
        "Name[pt_BR]": "Tocaê",
        "Comment[pt_BR]": "Reprodutor multimídia minimalista",
        "Comment[en]": "Minimalist media player",
        "Keywords": "video;audio;image;player;playlist;media;vídeo;música;imagem;reprodutor;",
        "StartupNotify": "true"
      }
    }
  },
  "deb": {
    "depends": ["perl"],
    "packageCategory": "video",
    "priority": "optional"
  },
  "rpm": {
    "depends": ["perl"],
    "packageCategory": "video"
  },
  "win": {
    "target": ["nsis"],
    "icon": "public/tocae.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
