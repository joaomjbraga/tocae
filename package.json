  },
  "desktopName": "io.github.joaomjbraga.tocae-reprodutor.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --linux deb rpm --publish never",
    "build:windows": "tsc && vite build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^39.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.52.0",
    "music-metadata": "^12.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-electron": "^0.29.1"
  },
  "main": "dist-electron/main.js"
