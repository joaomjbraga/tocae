{
  "name": "tocae",
  "private": true,
  "version": "1.0.0",
  "description": "Reprodutor multimídia minimalista",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "João M J Braga <joaomarcos.jbraga@gmail.com>",
  "homepage": "https://github.com/joaomjbraga/tocae",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaomjbraga/tocae.git"
  },
  "desktopName": "tocae",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "stylelint \"src/**/*.css\"",
    "test": "node --test",
    "audit:release": "node scripts/audit-release.mjs",
    "build:linux": "node scripts/clean-build.mjs && tsc && vite build && electron-builder --linux deb rpm --publish never",
    "build:windows": "node scripts/clean-build.mjs && tsc && vite build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@google/genai": "2.32.0",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^39.4.0",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.7.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended": "^17.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-electron": "^0.29.1"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "@derhuerst/ffprobe-static@5.3.0": true,
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
